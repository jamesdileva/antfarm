{
  "name": "antfarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npx tsx watch apps/orchestrator/src/main.ts --dry-run",
    "start": "npx tsx apps/orchestrator/src/main.ts",
    "observe": "npx tsx apps/observer-cli/src/main.ts",
    "dashboard": "npx tsx apps/dashboard/src/main.ts",
    "stats": "npx tsx apps/orchestrator/src/main.ts stats",
    "serve": "npx tsx apps/orchestrator/src/main.ts serve",
    "bundle": "node scripts/bundle-serve.mjs",
    "package": "npm run build && npm run bundle && node scripts/package-native.mjs && cd apps/shell && npx electron-builder --win --dir",
    "e2e": "node scripts/e2e-packaged.mjs",
    "build": "npx tsc -b",
    "test": "npx vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
